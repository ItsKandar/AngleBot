# ---------------------------------------------------------------------------
# Variables passees au conteneur RSSHub (copiez en rsshub.env).
# Fichier optionnel : sans lui, RSSHub demarre avec ses valeurs par defaut.
# Noms verifies dans lib/config.ts de RSSHub ; doc : https://docs.rsshub.app/deploy/config
# ---------------------------------------------------------------------------

# Instagram : indispensable, la route refuse de repondre sans identifiants.
IG_USERNAME=
IG_PASSWORD=
# Alternative aux identifiants : le cookie de session d'un compte connecte.
IG_COOKIE=

# X / Twitter : valeur du cookie "auth_token" d'un compte connecte
# (plusieurs valeurs separees par des virgules pour alterner).
TWITTER_AUTH_TOKEN=

# TikTok et Threads n'ont aucune variable dediee : ils passent par le
# navigateur embarque dans l'image chromium-bundled.

# Duree de cache des routes, en secondes (defaut 300).
CACHE_EXPIRE=600
