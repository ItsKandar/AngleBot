# --- Obligatoire ---
DISCORD_TOKEN=colle_ici_le_token_du_bot

# Salon de repli utilise quand une source n'a pas de "channel_id" dans config.yaml
DISCORD_DEFAULT_CHANNEL_ID=123456789012345678

# --- Optionnel ---
# Guilde de test : les commandes / y apparaissent instantanement.
# Vide = synchronisation globale (propagation jusqu'a 1h).
DISCORD_GUILD_ID=

# Instance RSSHub utilisee pour TikTok / Instagram / Threads / X.
# L'instance publique refuse la plupart de ces routes (403/404).
# Avec docker-compose, cette valeur est ignoree : le bot vise http://rsshub:1200.
RSSHUB_BASE=https://rsshub.app
# Cle d'acces de votre RSSHub. Avec docker-compose, la meme valeur est
# transmise au conteneur RSSHub (ACCESS_KEY) : les deux restent synchronises.
RSSHUB_KEY=

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
